# THRASH reads plain environment variables. Export them in your shell profile.
THRASH_MODEL=gemma3:4b
THRASH_OLLAMA_URL=http://localhost:11434
# THRASH_HOME=~/.local/share/thrash

# Scheduler heuristic thresholds (see README, "How thrashing is detected")
THRASH_WINDOW_HOURS=4
THRASH_SWITCH_LIMIT=6
THRASH_MEDIAN_SESSION_MIN=20
THRASH_RECON_LIMIT=3
THRASH_MAX_ACTIVE=4
THRASH_SIGNALS_REQUIRED=2
THRASH_STALE_HOURS=24
THRASH_ZOMBIE_DAYS=14
